{
  "name": "deleg8",
  "version": "0.1.0",
  "description": "MCP server that wraps oh-my-pi (`omp --mode rpc`) as named, persistent subagents addressable from Claude Code.",
  "type": "module",
  "bin": {
    "deleg8": "./src/server.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --target=bun --outfile=dist/deleg8.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "inspector": "bunx @modelcontextprotocol/inspector bun run src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
